# Copy to `.env` at the repo root on the production server (NOT committed —
# see .gitignore). docker-compose.yml reads this file automatically, since
# Docker Compose auto-loads a `.env` next to the compose file.
#
# For local development, see README.md instead — this file is for the Docker
# deploy only.

