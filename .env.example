# Copy to `.env` at the repo root on the production server (NOT committed —
# see .gitignore). docker-compose.yml reads this file automatically, since
# Docker Compose auto-loads a `.env` next to the compose file.
#
# For local development, see README.md instead — this file is for the Docker
# deploy only.

POSTGRES_USER=rahyad
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=rahyad

# openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-value

# Optional, and only read by the one-off `create-admin` run that makes the
# first admin account on the server. Left unset it creates the documented
# starting account (matthew@rahyad.ir / matthew1234) — fine to use and then
# change from inside the panel, but on a site that is already public prefer
# setting a real password here so it never comes from the repository.
# Delete the password line again once the account exists.
#
# Nothing else on the deploy path creates a user: migrations only move the
# schema, and the content snapshot deliberately skips accounts.
# See docs/DEPLOYMENT.md.
#ADMIN_EMAIL=you@rahyad.ir
#ADMIN_PASSWORD=at-least-8-characters
#ADMIN_NAME=Your Name
