{
  "name": "rahyad",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @rahyad/web",
    "build": "npm run build -w @rahyad/web",
    "start": "npm run start -w @rahyad/web",
    "lint": "npm run lint -w @rahyad/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run generate -w @rahyad/db",
    "db:migrate": "npm run migrate -w @rahyad/db",
    "db:seed": "npm run seed -w @rahyad/db",
    "db:studio": "npm run studio -w @rahyad/db",
    "postinstall": "npm run generate -w @rahyad/db"
  }
}
